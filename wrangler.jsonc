{
  // Deploy-to-Cloudflare template. Cloudflare provisions fresh KV/R2/DO
  // for whoever deploys — the placeholder id below is replaced automatically.
  "name": "social-node",
  "compatibility_date": "2026-06-08",
  "main": "worker.js",
  "workers_dev": true,
  // Optional — cookieless traffic analytics (Cloudflare Web Analytics beacon +
  // GET /admin/analytics report; see PROTOCOL.md "Traffic analytics"). Uncomment and
  // fill from your dashboard; also set the ANALYTICS_TOKEN secret. Omit to disable.
  // "vars": {
  //   "ANALYTICS_BEACON_TOKEN": "<web analytics snippet token>",
  //   "ANALYTICS_SITE_TAG": "<hex id from the manage-site URL>",
  //   "ANALYTICS_ACCOUNT_ID": "<your cloudflare account id>"
  // },
  "kv_namespaces": [
    {
      "binding": "NODE_STATE",
      "id": "placeholder_kv_id"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NODE_MEDIA",
      "bucket_name": "social-node-media"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE_ROOM",
        "class_name": "LiveRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LiveRoom"]
    }
  ]
}
